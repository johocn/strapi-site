{
  "name": "vcash",
  "version": "0.1.0",
  "private": true,
  "description": "vcash POS 系统 - Vendure 多租户多仓库收银",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "dev": "pnpm --filter server dev",
    "build:server": "pnpm --filter server build",
    "populate": "pnpm --filter server populate"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  },
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "@vendure/delivery-plugin": "file:../vendure/packages/delivery-plugin",
      "@graphql-tools/delegate": "12.1.0"
    }
  }
}
